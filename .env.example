# URL pública del aplicativo (se usa en el enlace que recibe el tercero para corregir un expediente devuelto)
PORT=3000
BASE_URL=http://localhost:3000
# Con Docker y HTTPS: BASE_URL=https://SU-DOMINIO

# Cadena larga y aleatoria en producción
SESSION_SECRET=cambie-este-secreto

# Usuario administrador inicial (solo se crea si no existe ningún usuario)
ADMIN_USER=admin
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=Arcilaza2026*

# Almacenamiento
DB_PATH=data/vinculacion.db
# Raíz de los expedientes: PROVEEDORES/2026/PRO-2026-0042 NOMBRE/, EMPLEADOS/EMP-2026-0049 NOMBRE/…
ARCHIVO_DIR=archivo/SOPORTES CREACION TERCEROS
CORREOS_DIR=data/correos
# Formulario Word que descarga el tercero en el paso 1
FORMULARIO_WORD=documentos/FOR-DCF-001.docx
# Meses tras la aprobación para que un tercero aparezca en "Por actualizar"
MESES_ACTUALIZACION=12

# Pie de página del portal y de los correos
EMPRESA_DIRECCION=Finca La Pradera, Vereda El Caimo, Armenia (Quindío)
EMPRESA_CORREO=facturacionelectronica@cofinet.com.au

# Oficial de Cumplimiento: recibe el correo automático al aprobar un expediente
OFICIAL_CUMPLIMIENTO_NOMBRE=Oficial de Cumplimiento
OFICIAL_CUMPLIMIENTO_EMAIL=
OFICIAL_CUMPLIMIENTO_CC=

# Correo saliente (SMTP). Office 365: smtp.office365.com, puerto 587, SMTP_SECURE=false.
# Si SMTP_HOST está vacío, los correos se guardan como .eml en CORREOS_DIR (modo simulado).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vinculación de terceros <vinculacion@cofinet.com.au>

# SharePoint (opcional): copia cada expediente a una biblioteca de documentos vía Microsoft Graph.
# Requiere un registro de aplicación en Entra ID con permiso de aplicación Sites.ReadWrite.All (o Sites.Selected).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_CARPETA_RAIZ=SOPORTES CREACION TERCEROS

# --- Docker ---
# Puerto del servidor donde queda el aplicativo sin HTTPS
PUERTO_LOCAL=3000
# Dominio para HTTPS automático (perfil "https" de docker compose). Debe apuntar (DNS) a este servidor.
DOMINIO=
