# Puerto y URL pública del aplicativo
PORT=3000
BASE_URL=http://localhost:3000

# Cambie este valor por una cadena larga y aleatoria en producción
SESSION_SECRET=cambie-este-secreto

# Usuario administrador inicial (solo se crea si no existe ningún usuario)
ADMIN_USER=admin
ADMIN_PASSWORD=Arcilaza2026*

# Almacenamiento
DB_PATH=data/terceros.db
UPLOADS_DIR=uploads
CORREOS_DIR=data/correos
MAX_FILE_MB=10

EMPRESA_NOMBRE=INVERSORA ARCILAZA S.A.S.

# Correo saliente (SMTP). Si SMTP_HOST está vacío, los correos se guardan como
# archivos .eml en CORREOS_DIR (modo simulado) en lugar de enviarse.
# Office 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vinculación de terceros <no-reply@arcilaza.com>
# Destinatario(s) sugerido(s) por defecto, separados por coma
MAIL_DEFAULT_TO=
